# Copy to .env and fill in. NEVER commit .env - in staging/prod inject these from
# Azure Key Vault / AWS Secrets Manager / Vault via your orchestrator.

ENVIRONMENT=dev
POSTGRES_PASSWORD=aiusage

# --- Auth: "dev" (demo personas) or "oidc" (Entra ID / Okta / Ping) -------------
AUTH_MODE=dev
JWT_SECRET=change-me-dev-only
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin account created by `python -m app.seed --clean` (your sign-in in dev mode)
ADMIN_EMAIL=admin@local

# --- Privacy ----------------------------------------------------------------------
PSEUDONYMIZE_USERS=false
PSEUDONYMIZATION_KEY=change-me
RAW_EVENT_RETENTION_DAYS=400
MIN_GROUP_SIZE=1

# --- Collectors: fill only those you use (blank = disabled) -------------------------
COLLECTOR_INTERVAL_MINUTES=60
COLLECTOR_LOOKBACK_DAYS=3
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=
AZURE_OPENAI_RESOURCE_IDS=
# For Azure collectors running outside Azure: AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
AWS_REGION=us-east-1
BEDROCK_ENABLED=false
GCP_BILLING_TABLE=
GITHUB_ORG=
GITHUB_TOKEN=
COPILOT_SEAT_PRICE_USD=19
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
M365_COPILOT_SEAT_PRICE_USD=30

# ---- HR directory: who is in which department (docs/INTEGRATIONS.md) ----
# Workday RaaS custom report (JSON) read by an Integration System User
WORKDAY_REPORT_URL=
WORKDAY_USERNAME=
WORKDAY_PASSWORD=
# WORKDAY_FIELD_MAP={"email":"Work_Email"}
# Or read department / cost centre from Entra ID (needs Graph User.Read.All on the MS_GRAPH app)
ENTRA_DIRECTORY_SYNC=false
DIRECTORY_SYNC_INTERVAL_MINUTES=720
DIRECTORY_REATTRIBUTE_DAYS=90
# A RAG app shows as "Running" if it reported usage within this many minutes
APP_LIVE_MINUTES=60
